{
  "name": "jira-bulk-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx apps/server/src/index.ts --dev",
    "build": "tsc --noEmit && vite build",
